.venv/
site/
__pycache__/

# The original Google Docs export contains personal phone numbers and email
# addresses and must never be committed. The website version of the document
# (docs/event-plan.md) references them via build-time secrets instead.
/EventPlan.md

# Bernard Tao's full Oxford Isis Maps source SVG is kept outside the
# repository; scripts/strip_map.py extracts what the site needs from it.
/IsisMap.svg
*:Zone.Identifier

# Real contact details for local builds (see contacts.local.example.yml).
# Must never be committed.
/contacts.local.yml
# Locally built PDFs for submission: the event plan contains those real
# contact details, and the risk assessment is sent alongside it.
/Tamesis2026_EventPlan.pdf
/Tamesis2026_RiskAssessment.pdf

# Source documents kept beside the repo but never committed: the Word event
# plan contains personal contact details, and the spreadsheet and circulation
# PDFs are originals that the site's own versions are made from.
*.docx
*.xlsx
/Tamesis 2026 Circulation *.pdf
